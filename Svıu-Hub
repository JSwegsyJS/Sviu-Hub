tabMain.newToggle("Esp Death Counter", "Esp DC", false, function(Value)
    getgenv().EspDeathCounter = Value

    if Value then
        -- ESP fonksiyonu
        local function espPlayer(player)
            if player ~= game.Players.LocalPlayer then
                local billboardGui = Instance.new("BillboardGui")
                billboardGui.Name = "Esp"
                billboardGui.Adornee = player.Character.Head
                billboardGui.Size = UDim2.new(2, 0, 1, 0)
                billboardGui.StudsOffset = Vector3.new(0, 2, 0)
                billboardGui.AlwaysOnTop = true

                local textLabel = Instance.new("TextLabel")
                textLabel.Text = "Mal"
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                textLabel.TextScaled = true
                textLabel.Parent = billboardGui

                billboardGui.Parent = player.Character.Head
            end
        end

        -- Death Counter yeteneğini kullananları kontrol et
        game:GetService("RunService").RenderStepped:Connect(function()
            for _, player in ipairs(game.Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("Humanoid") then
                    local humanoid = player.Character.Humanoid
                    if humanoid:FindFirstChild("Animator") then
                        local animator = humanoid.Animator
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            if track.Name == "Death Counter" and getgenv().EspDeathCounter then
                                espPlayer(player)
                                -- Animation bitince ESP'yi kaldır
                                track.Stopped:Connect(function()
                                    if player.Character and player.Character:FindFirstChild("Head") then
                                        local head = player.Character.Head
                                        local esp = head:FindFirstChild("Esp")
                                        if esp then
                                            esp:Destroy()
                                        end
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end)

    else
        -- ESP'yi devre dışı bırakma
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local esp = head:FindFirstChild("Esp")
                    if esp then
                        esp:Destroy()
                    end
                end
            end
        end
    end
end)


